{
  "$comment": "A BelayKit rulebook: version, hitPolicyDefault, outputs (what rules.decide returns), and sections, each with a name, when, needs, hitPolicy, exhaustive and rules; a rule has an optional id and selectFirst (one binding name mapped to a CEL list expression), a when, a then naming a registered action, and a why. Anything else is a CEL expression or a registered action.",
  "type": "object",
  "required": ["version", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "hitPolicyDefault": { "enum": ["FIRST", "ALL"] },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "when"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "when": { "type": "string" },
          "needs": { "type": "object", "additionalProperties": { "type": "string" } },
          "hitPolicy": { "enum": ["FIRST", "ALL"] },
          "exhaustive": { "const": false },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["when", "then"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "selectFirst": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
                  "additionalProperties": { "type": "string" }
                },
                "when": { "type": "string" },
                "then": {
                  "type": "object",
                  "required": ["action"],
                  "properties": { "action": { "type": "string" } }
                },
                "why": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
