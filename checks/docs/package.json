  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run --dir __tests__"
  },
  "dependencies": {
    "@belaykit/core": "workspace:*",
    "@belaykit/rulebook": "workspace:*",
    "belaykit": "workspace:*",
