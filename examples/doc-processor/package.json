{
  "name": "doc-processor",
  "version": "0.1.0",
  "description": "BelayKit's example agent: extract a document's snippets, place each in a topic map and type it — written with and without a rulebook.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "belaykit-rulebook check rules/doc-processor.rules.yaml --registry src/registry.js#registry",
    "reference": "belaykit-rulebook reference --registry src/registry.js#registry"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@belaykit/core": "workspace:*",
    "@belaykit/rulebook": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  }
}
